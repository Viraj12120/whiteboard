# Optional OpenAI-compatible chat-completions endpoint.
# Without these settings, the app shows setup guidance instead of AI answers.
TUTOR_API_URL=
TUTOR_API_KEY=
TUTOR_MODEL=
# Optional OpenRouter reasoning control (for example: none).
TUTOR_REASONING_EFFORT=
# Optional strict JSON schema output for providers that support it.
TUTOR_USE_JSON_SCHEMA=
